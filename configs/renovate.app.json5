// A complete configuration for an application repository with .NET (NuGet)
// and Node.js (npm). It combines the configurations of features 01 to 08.
// Copy it to renovate.json5 in the root of the repository.
//
// Each block names the feature that explains it. The order of packageRules
// matters: if two rules set the same option, the later rule wins.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Feature 01. The preset that the Renovate onboarding PR suggests. It also
  // turns on the Dependency Dashboard (04), the monorepo groups (02) and the
  // replacement presets (06).
  extends: ['config:recommended'],

  // Feature 01. Every Renovate PR gets this label.
  labels: ['dependencies'],

  // Feature 04. The issue is on by default. These lines pin it.
  dependencyDashboard: {
    pinned: true,
  },

  packageRules: [
    // Feature 01. One label per ecosystem, and one for major updates.
    {
      matchManagers: ['npm'],
      addLabels: ['npm'],
    },
    {
      matchManagers: ['nuget'],
      addLabels: ['nuget'],
    },
    {
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },

    // Feature 02. A custom group.
    {
      description: 'Put the npm tools for formatting and Git hooks in one PR',
      matchManagers: ['npm'],
      matchDepTypes: ['devDependencies'],
      matchPackageNames: ['prettier', 'lint-staged', 'husky'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'npm dev tooling',
    },

    // Feature 03. Automerge for patch updates, approval for major updates.
    {
      description: 'Automerge patch updates after all checks pass',
      matchUpdateTypes: ['patch'],
      matchCurrentVersion: '!/^0/',
      automerge: true,
    },
    {
      description: 'A person must approve each major update in the Dependency Dashboard',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },

    // Feature 06. An own replacement rule, and a label for all replacements.
    {
      description: 'Replace the deprecated API versioning package',
      matchDatasources: ['nuget'],
      matchPackageNames: ['Microsoft.AspNetCore.Mvc.Versioning'],
      replacementName: 'Asp.Versioning.Mvc',
      replacementVersion: '8.1.0',
    },
    {
      matchUpdateTypes: ['replacement'],
      addLabels: ['replacement'],
    },

    // Feature 08. Rollback PRs for rc only. npm removed rc 1.2.9 on
    // 2021-11-04, because the version had malware.
    {
      description: 'Roll back rc when the registry no longer has the pinned version',
      matchPackageNames: ['rc'],
      rollbackPrs: true,
    },

    // Feature 08. A controlled rollback. FluentAssertions 8.0.0 is still on
    // NuGet, but it has a paid license for commercial use. 'extractVersion'
    // hides 8.x, so the current version looks missing and Renovate opens a
    // rollback PR. 'allowedVersions' blocks updates to 8.x as a second guard.
    {
      description: 'Roll back FluentAssertions from 8.0.0 and hold it below 8',
      matchDatasources: ['nuget'],
      matchPackageNames: ['FluentAssertions'],
      extractVersion: '^(?<version>[0-7]\\..+)$',
      rollbackPrs: true,
      // The NuGet manager uses 'bump' by default. With 'bump', Renovate
      // drops the rollback when the current version is missing.
      rangeStrategy: 'replace',
      allowedVersions: '(,8.0.0)',
    },
  ],

  // Feature 05. A new lock file each Monday before 04:00.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 4am on monday'],
  },

  // Feature 07. Security PRs ignore the schedule and the PR limits.
  vulnerabilityAlerts: {
    addLabels: ['security'],
  },

  // Feature 08. A label for rollback PRs.
  rollback: {
    addLabels: ['rollback'],
  },
}
